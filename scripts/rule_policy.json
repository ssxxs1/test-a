{
  "policy_version": 2,
  "qx_policy": "Advertising",
  "profile_limits": {
    "mac": 20000,
    "mobile": 10000,
    "lite": 2000
  },
  "random_domain_policy": {
    "hex_label_min_length": 12,
    "numeric_label_min_length": 12,
    "mixed_label_min_length": 18,
    "mixed_label_min_digit_ratio": 0.5
  },
  "admission_label_tokens": [
    "ad",
    "ads",
    "adserver",
    "adservice",
    "advertising",
    "advertisement",
    "adnxs",
    "banner",
    "beacon",
    "pixel",
    "tracker",
    "tracking",
    "telemetry",
    "analytics",
    "attribution",
    "affiliates",
    "affiliate",
    "rtb",
    "ssp",
    "dsp",
    "promoted",
    "sponsor",
    "sponsored"
  ],
  "admission_label_patterns": [
    "^ad(?:s|x)?(?:[0-9]+|server|service|serving|network|exchange|tech|manager|system|form|mob|sdk|unit|slot|delivery|click|proxy|track|log|stat|img|api)?$",
    "^(?:ad[a-z0-9-]{2,}|track(?:er|ing)?[a-z0-9-]*|analytics?[a-z0-9-]*|metrics?[a-z0-9-]*|stat(?:istic|istics)?[a-z0-9-]*|pixel[a-z0-9-]*|beacon[a-z0-9-]*)$",
